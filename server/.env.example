# =========================================================
# TNSCON 2027 BACKEND ENVIRONMENT CONFIGURATION
# =========================================================
PORT=5001
NODE_ENV=production

# Database Connection (MySQL / MariaDB)
DATABASE_URL="mysql://username:password@localhost:3306/tnscon2027_db"

# JWT Authentication Secret (Use a strong 64+ char random string)
JWT_SECRET="generate_a_secure_random_jwt_secret_for_production_deployment"

# Initial Admin Credentials (Changed upon initial sign-in)
ADMIN_USER="tnscon"
ADMIN_PASS="change_this_password_in_production"

# CORS Configuration (Comma-separated allowed origins)
ALLOWED_ORIGINS="https://www.tnscon2027hyd.com,https://tnscon2027hyd.com,http://localhost:5173"

# SMTP Mail Server Credentials (Configured by Secretariat)
SMTP_HOST="smtp.example.com"
SMTP_PORT=465
SMTP_USER="secretariat@tnscon2027hyd.com"
SMTP_PASS="secretariat_password"
SMTP_FROM="secretariat@tnscon2027hyd.com"
SMTP_FROM_NAME="TNSCON 2027 Secretariat"
